# Database Configuration
DB_NAME=msadetector
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password-here

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-32-characters
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080
BACKEND_PORT=8080

# Analysis Configuration
WORKSPACE_DIR=/tmp/msa-detector/workspace
DESIGNITE_JAR_PATH=/opt/designite/DesigniteJava.jar
CLONE_TIMEOUT=300
ANALYSIS_TIMEOUT=1800

# Threshold Configuration
NANO_MAX_LOC=500
NANO_MAX_ENDPOINTS=2
GOD_MIN_DOMAINS=3
CHATTY_MIN_CALLS=5
# Code Quality: smells per 1000 LOC at which the Code Quality category hits its full penalty
CODE_SMELL_DENSITY_THRESHOLD=70

# Version (for Docker images)
VERSION=latest
# FRONTEND_VERSION=latest
# FRONTEND_PORT=80          # set to 4200 if port 80 is taken (e.g. IIS on Windows)
