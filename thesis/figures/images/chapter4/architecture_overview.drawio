<mxfile host="app.diagrams.net" agent="GitHub Copilot" version="24.0.0">
  <diagram id="architecture-overview" name="Architecture Overview">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Docker Compose boundary -->
        <mxCell id="docker-boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#999999;fillColor=none;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="1000" height="580" as="geometry" />
        </mxCell>
        <mxCell id="docker-label" value="&lt;b&gt;Docker Compose&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="95" y="105" width="130" height="30" as="geometry" />
        </mxCell>

        <!-- User / Browser (C4 Person) -->
        <mxCell id="user" value="&lt;b&gt;User / Browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;A developer who wants&lt;br&gt;to analyze their microservice&lt;br&gt;architecture for anti-patterns&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="-100" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Frontend Container (C4 Container) -->
        <mxCell id="frontend" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;[Container: Angular SPA / Nginx]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Serves the single-page&lt;br&gt;application and proxies&lt;br&gt;API requests to the backend.&lt;br&gt;Port 80 / 4200&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;arcSize=8;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="130" y="160" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- Backend Container (C4 Container) -->
        <mxCell id="backend" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;[Container: Spring Boot / Java 25]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Exposes REST API, orchestrates&lt;br&gt;the analysis pipeline, runs&lt;br&gt;anti-pattern detection.&lt;br&gt;Port 8080&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;arcSize=8;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="570" y="160" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- PostgreSQL Database (C4 Container - Database) -->
        <mxCell id="db" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;[Container: Database]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Stores users, projects,&lt;br&gt;microservices, analysis results,&lt;br&gt;anti-patterns, code snippets,&lt;br&gt;and dependency graphs.&lt;br&gt;Port 5432&lt;/font&gt;" style="shape=mxgraph.c4.webBrowserContainer2;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;align=center;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="400" width="260" height="160" as="geometry" />
        </mxCell>

        <!-- Workspace Volume -->
        <mxCell id="workspace" value="&lt;b&gt;Workspace Volume&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;[Docker Volume]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Stores cloned Git repositories&lt;br&gt;and extracted ZIP archives&lt;br&gt;for analysis.&lt;/font&gt;" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#FFF2CC;fontColor=#333333;strokeColor=#D6B656;fontSize=12;align=center;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="420" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- DesigniteJava -->
        <mxCell id="designite" value="&lt;b&gt;DesigniteJava&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;[External Tool: JAR]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Code smell detection tool.&lt;br&gt;Read-only volume mount.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;fontColor=#333333;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="370" y="590" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS ===== -->

        <!-- User -> Frontend: HTTPS -->
        <mxCell id="arrow-user-frontend" value="&lt;font style=&quot;font-size:11px;&quot;&gt;HTTPS&lt;/font&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;fontSize=11;edgeStyle=orthogonalEdgeStyle;" edge="1" source="user" target="frontend" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Frontend -> Backend: HTTP/REST /api/* proxy -->
        <mxCell id="arrow-frontend-backend" value="&lt;font style=&quot;font-size:11px;&quot;&gt;HTTP/REST&lt;br&gt;/api/* proxy&lt;/font&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;fontSize=11;edgeStyle=orthogonalEdgeStyle;" edge="1" source="frontend" target="backend" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend -> PostgreSQL: JDBC -->
        <mxCell id="arrow-backend-db" value="&lt;font style=&quot;font-size:11px;&quot;&gt;JDBC&lt;br&gt;(Spring Data JPA)&lt;/font&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;fontSize=11;edgeStyle=orthogonalEdgeStyle;" edge="1" source="backend" target="db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend -> Workspace: read/write -->
        <mxCell id="arrow-backend-workspace" value="&lt;font style=&quot;font-size:11px;&quot;&gt;read / write&lt;br&gt;(filesystem)&lt;/font&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;fontSize=11;edgeStyle=orthogonalEdgeStyle;startArrow=block;startFill=1;" edge="1" source="backend" target="workspace" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="350" />
              <mxPoint x="520" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Backend -> DesigniteJava: subprocess -->
        <mxCell id="arrow-backend-designite" value="&lt;font style=&quot;font-size:11px;&quot;&gt;Invokes as&lt;br&gt;subprocess&lt;/font&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;fontSize=11;edgeStyle=orthogonalEdgeStyle;" edge="1" source="backend" target="designite" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DesigniteJava -> Workspace: reads source (dashed) -->
        <mxCell id="arrow-designite-workspace" value="&lt;font style=&quot;font-size:11px;&quot;&gt;Reads source&lt;br&gt;code&lt;/font&gt;" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#999999;fontColor=#666666;fontSize=11;dashed=1;dashPattern=8 4;edgeStyle=orthogonalEdgeStyle;" edge="1" source="designite" target="workspace" parent="1">
          <mxGeometry relative="1" as="geometry" />
